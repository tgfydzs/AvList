<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ==================== 主内容区（原 CoordinatorLayout） ==================== -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical"
            android:background="?attr/colorPrimary"
            android:elevation="4dp"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:alpha="0.6"/>

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="搜索番号、标题、标签、备注、内容"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAFFFFFF"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:maxLines="1"
                        android:singleLine="true"/>

                    <ImageView
                        android:id="@+id/ivClear"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:alpha="0.6"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnSort"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="排序"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="8dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_fade"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/llBottomAction"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="bottom"
            android:background="@android:color/white"
            android:visibility="gone"
            android:orientation="horizontal"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBatchDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除"
                android:layout_marginEnd="16dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBatchMoveOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="移出"
                android:layout_marginEnd="16dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBatchExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出"/>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:src="@android:drawable/ic_menu_add"
            app:backgroundTint="#664FA3"
            app:tint="@android:color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ==================== 右侧滑出菜单 ==================== -->
    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:clickable="true"
        android:focusable="true">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="菜单"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginHorizontal="16dp"/>

        <!-- 导出JSON -->
        <TextView
            android:id="@+id/drawer_export"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="导出 JSON"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <!-- 导入JSON -->
        <TextView
            android:id="@+id/drawer_import"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="导入 JSON"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <!-- 导入番号列表 -->
        <TextView
            android:id="@+id/drawer_import_txt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="导入番号列表"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp"/>

        <!-- 多选模式 -->
        <TextView
            android:id="@+id/drawer_multi_select"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="多选模式"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <!-- 跳转源 -->
        <TextView
            android:id="@+id/drawer_jump_source"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="跳转源"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <!-- 刮削源 -->
        <TextView
            android:id="@+id/drawer_scrape_source"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="刮削源"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <!-- 使用说明 -->
        <TextView
            android:id="@+id/drawer_guide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="使用说明"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp"/>

        <!-- 运行日志 -->
        <TextView
            android:id="@+id/drawer_log"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="运行日志"
            android:textSize="15sp"
            android:textColor="#333333"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
