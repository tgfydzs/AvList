<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 上次备份时间 -->
    <TextView
        android:id="@+id/tvLastBackupTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#666666"
        android:text="上次备份：从未备份"/>

    <!-- 存储位置 -->
    <TextView
        android:id="@+id/tvBackupPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:text="自动备份目录："/>

    <!-- 备份数量 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="备份数量："
            android:textSize="13sp"
            android:textColor="#666666"/>

        <Spinner
            android:id="@+id/spBackupCount"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBackupCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#999999"
        android:text="超出上限自动覆盖最旧备份"
        android:layout_marginTop="2dp"/>

    <!-- 备份间隔（天） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="备份间隔："
            android:textSize="13sp"
            android:textColor="#666666"/>

        <EditText
            android:id="@+id/etBackupInterval"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:inputType="number"
            android:gravity="center"
            android:background="@drawable/btn_jump_bg"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="天（1-30）"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- 立即备份按钮 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBackupNow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:text="导出备份（选择保存位置）"
        android:textSize="14sp"/>

    <!-- 现有备份列表 -->
    <TextView
        android:id="@+id/tvBackupFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#AAAAAA"
        android:maxHeight="120dp"
        android:scrollbars="vertical"
        android:layout_marginTop="8dp"
        android:text="暂无备份文件"/>

</LinearLayout>
